# Die Adresse, unter der Mitarbeiter die Anwendung erreichen (ohne abschließenden Pfad).
BASE_URL=http://localhost:3000
HTTP_PORT=3000
# Für Zugriff aus dem internen Netz auf 0.0.0.0 ändern.
BIND_ADDRESS=127.0.0.1

# Fertiges Image fuer compose.yaml, nach dem ersten veroeffentlichten GitHub-Release.
# Beispiel: ghcr.io/dein-account/dein-repository:latest
IMAGE=

# Optional: HTTPS-URL eines Teams-Workflows, keine alte Office-365-Connector-URL.
TEAMS_WEBHOOK_URL=

# Nur für direkten Node-Betrieb (Docker verwendet fest /data und Port 3000):
# DATA_DIR=./data
# PORT=3000
# HOST=127.0.0.1
