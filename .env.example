# Address employees use to reach the application (without a subpath).
BASE_URL=http://localhost:3000
HTTP_PORT=3000
# Set to 0.0.0.0 to allow access from the internal network.
BIND_ADDRESS=127.0.0.1

# Published image for compose.yaml, available after the first GitHub release.
# Example: ghcr.io/your-account/your-repository:latest
IMAGE=

# Optional: HTTPS URL of a Teams workflow, not a legacy Office 365 connector URL.
TEAMS_WEBHOOK_URL=
# Shared Teams message language: de (default) or en. Browser language is selected separately.
TEAMS_LANGUAGE=de

# Only for direct Node execution (Docker uses /data and port 3000):
# DATA_DIR=./data
# PORT=3000
# HOST=127.0.0.1
